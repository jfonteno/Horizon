# Copy to horizon-auth.env beside Start-Horizon-Windows.cmd.
# The Windows launcher creates and preserves HORIZON_AUTH_SECRET automatically.

# Steam works without an API key.
HORIZON_STEAM_SIGNIN=enabled

# Live passwordless email through Resend.
HORIZON_EMAIL_PROVIDER=resend
RESEND_API_KEY=
HORIZON_EMAIL_FROM=Horizon Command <command@horizongame.us>

# Google OpenID Connect web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple Services ID and current client-secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Comma-separated Commander IDs that receive Operations Owner access.
HORIZON_ADMIN_ACCOUNT_IDS=
