# Copy this file to .env before starting Docker Compose.
# Leave blank when the optional Cloudflare Tunnel profile is not used.
CLOUDFLARE_TUNNEL_TOKEN=
HORIZON_PORT=3000
HORIZON_BACKUP_RETENTION_DAYS=14
# Match these to `id -u` and `id -g` on the server.
HORIZON_UID=1000
HORIZON_GID=1000

# Required before platform sign-in is enabled. Generate at least 32 random characters.
HORIZON_AUTH_SECRET=
# Comma-separated Commander IDs that receive the Operations Owner role.
HORIZON_ADMIN_ACCOUNT_IDS=
# Startup default. The Operations console persists later changes.
HORIZON_MULTIPLAYER_VERIFICATION=commander

# Google OpenID Connect web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple Services ID and a current Apple client-secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Steam OpenID requires no API key. Set this to disabled to hide Steam sign-in.
HORIZON_STEAM_SIGNIN=disabled

# Passwordless email. Use "resend" for live delivery or "console" only for host-supervised testing.
HORIZON_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
HORIZON_EMAIL_FROM=Horizon Command <command@horizongame.us>
