{
  "name": "horizon-shattered-reach",
  "version": "0.35.10",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "node scripts/task-runner.mjs build",
    "build:self-hosted": "node scripts/task-runner.mjs build --standalone",
    "start": "vinext start",
    "start:self-hosted": "node --import tsx scripts/start-self-hosted.ts",
    "backup:self-hosted": "bash scripts/backup-self-hosted.sh",
    "restore:self-hosted": "bash scripts/restore-self-hosted.sh",
    "test": "node scripts/task-runner.mjs test",
    "simulate:ai": "node --import tsx scripts/simulate-ai.ts",
    "validate:artifact": "node scripts/task-runner.mjs validate-artifact",
    "validate:app": "node scripts/validate-app-readiness.mjs",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:balance": "node --import tsx scripts/validate-shattered-balance.ts",
    "lint": "node scripts/task-runner.mjs lint",
    "typecheck": "node scripts/task-runner.mjs typecheck",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "package:release": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "optionalDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Horizon: Shattered Reach"
}
